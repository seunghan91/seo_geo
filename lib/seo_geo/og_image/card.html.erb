<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  html, body { margin: 0; width: <%= width %>px; height: <%= height %>px; }
  body {
    box-sizing: border-box; padding: 72px 84px; display: flex; flex-direction: column; justify-content: flex-end;
    background: #f5f5f7; color: #111; font-family: -apple-system, "Segoe UI", "Noto Sans KR", "Apple SD Gothic Neo", sans-serif;
    word-break: keep-all; overflow-wrap: break-word;
  }
  .site { position: absolute; top: 72px; left: 84px; font-size: 32px; font-weight: 600; color: #555; }
  h1 { margin: 0; font-size: 72px; line-height: 1.15; text-wrap: balance; }
  p { margin: 24px 0 0; font-size: 34px; line-height: 1.4; color: #555; text-wrap: pretty; }
</style>
</head>
<body>
  <% if site.name %><div class="site"><%= h(site.name) %></div><% end %>
  <h1><%= h(page&.heading || page&.title || site.name || key) %></h1>
  <% if page&.description %><p><%= h(page.description) %></p><% end %>
</body>
</html>
